{
  "name": "etlab-auto-survey",
  "version": "2.0.0",
  "author": "Vivek K J",
  "description": "Cross-browser extension for filling ETLAB surveys and feedback with selectable ratings and instant submission",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "chrome-extension",
    "react",
    "vite",
    "create-chrome-ext"
  ],
  "engines": {
    "node": ">=14.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:chrome": "node scripts/build.js chrome",
    "build:firefox": "node scripts/build.js firefox",
    "build:all": "node scripts/build.js all",
    "preview": "vite preview",
    "test": "vitest run",
    "fmt": "prettier --write '**/*.{jsx,js,json,css,scss,md}'"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.0.14",
    "@types/react-dom": "^18.0.5",
    "@vitejs/plugin-react": "^1.3.2",
    "glob": "^9.3.0",
    "jsdom": "^30.1.2",
    "prettier": "^2.7.1",
    "vite": "^5.4.11",
    "vite-plugin-zip-pack": "^1.0.5",
    "vitest": "^2.1.9"
  }
}
